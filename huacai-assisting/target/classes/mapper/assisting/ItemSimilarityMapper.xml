<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.huacai.assisting.mapper.ItemSimilarityMapper">

    <!-- 清空表（使用 DELETE 便于事务管理） -->
    <delete id="truncateTable">
        DELETE FROM item_similarity
    </delete>

    <!-- 批量插入 -->
    <insert id="batchInsert" parameterType="list">
        INSERT INTO item_similarity (item_id_a, item_id_b, similarity) VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.itemIdA}, #{item.itemIdB}, #{item.similarity})
        </foreach>
    </insert>

    <!-- 查询与某商品最相似的N个商品 -->
    <select id="selectTopSimilar" resultType="string">
        SELECT item_id_b
        FROM item_similarity
        WHERE item_id_a = #{itemId}
        ORDER BY similarity DESC
            LIMIT #{limit}
    </select>

</mapper>