@startuml
scale 0.8
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultTextAlignment center
skinparam defaultFontSize 13
skinparam packageStyle rectangle
skinparam rectangle {
  RoundCorner 14
  Padding 6
}
skinparam package {
  RoundCorner 16
  Padding 8
}
top to bottom direction

package "前端UI" as FE {
  rectangle "用户端 Vue.js" as FE1
  rectangle "农户端 Vue.js" as FE2
  rectangle "管理端 Vue.js" as FE3
  FE1 -[hidden]right- FE2
  FE2 -[hidden]right- FE3
}

package "业务层" as BL {
  rectangle "用户注册登录" as BL1
  rectangle "商品浏览搜索" as BL2
  rectangle "购物车管理" as BL3
  rectangle "订单提交支付" as BL4
  rectangle "农户入驻审核" as BL5
  rectangle "政策与轮播图管理" as BL6

  BL1 -[hidden]right- BL2
  BL2 -[hidden]right- BL3
  BL4 -[hidden]right- BL5
  BL5 -[hidden]right- BL6

  BL1 -[hidden]down- BL4
  BL2 -[hidden]down- BL5
  BL3 -[hidden]down- BL6
}

package "数据层" as DL {
  rectangle "事务控制" as DL1
  rectangle "数据映射" as DL2
  rectangle "缓存" as DL3
  DL1 -[hidden]right- DL2
  DL2 -[hidden]right- DL3
}

package "基础服务" as SL {
  rectangle "MySQL" as SL1
  rectangle "MyBatis-Plus" as SL2
  rectangle "Redis" as SL3
  SL1 -[hidden]right- SL2
  SL2 -[hidden]right- SL3
}

package "网络服务" as NL {
  rectangle "Axios" as NL1
  rectangle "HTTP" as NL2
  rectangle "HTTPS" as NL3
  NL1 -[hidden]right- NL2
  NL2 -[hidden]right- NL3
}

package "账号权限控制" as AUTH {
}

FE1 -[hidden]down- BL1
BL1 -[hidden]down- DL1
DL1 -[hidden]down- SL1
SL1 -[hidden]down- NL1

FE3 -[hidden]right- AUTH
BL6 -[hidden]right- AUTH
DL3 -[hidden]right- AUTH
SL3 -[hidden]right- AUTH
NL3 -[hidden]right- AUTH

@enduml
